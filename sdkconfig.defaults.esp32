# AirPlay build: original ESP32 (NOT S3), ESP32-WROVER-E
# Flash size (4MB)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
# External PSRAM. WROVER-E 8MB: the original ESP32 can only map 4MB of it
# directly; the firmware needs ~2.7MB so the remainder is simply unused.
CONFIG_ESP32_SPIRAM_SUPPORT=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
# Small allocations (<=16KB) stay in fast internal RAM
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
# AirPlay: 240 MHz gives the RTP/ALAC decode more headroom than the 160 MHz default
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
